@article{zhang2024acsami,
  author  = {Zhang, Zheyu and Baudy, Axelle and Testino, Andrea and Gubler, Lorenz},
  title   = {Cathode Catalyst Layer Design in {PEM} Water Electrolysis toward
             Reduced {Pt} Loading and Hydrogen Crossover},
  journal = {ACS Applied Materials \& Interfaces},
  volume  = {16},
  number  = {18},
  pages   = {23265--23277},
  year    = {2024},
  doi     = {10.1021/acsami.4c01827},
  note    = {Open access (PMC11082850). Compares ultra-low Pt cathode loadings
             (0.025 mg_Pt/cm²) against baseline (0.1 mg_Pt/cm²); SOA reference
             0.5-1.0 mg_Pt/cm². I/C ratios 0.35 and 0.69. CL thickness 1-40 µm
             depending on Pt wt% on carbon (50 wt% on HSAC ≈ 1 µm; 5 wt% on
             Vulcan ≈ 40 µm at 0.025 mg_Pt/cm²). T = 80 °C, j = 0.2-3.0 A/cm².}
}

